{
  // Shared by every guide; long tutorial READMEs need a few relaxations.
  "config": {
    "default": true,
    "MD013": false,                      // line length: prose and tables run long
    "MD033": { "allowed_elements": ["div", "a", "img", "br", "details", "summary", "kbd", "sup", "sub"] },
    "MD024": { "siblings_only": true },  // "Pitfalls" may repeat under each stage
    "MD026": { "punctuation": ".,;:!" }, // interview headings end with "?"
    "MD036": false,                      // bold tagline under the title
    "MD041": true
  },
  "ignores": ["node_modules/**", "CHANGELOG.md"]
}
